# =============================================================================
# Master Node Environment — EXAMPLE
# Copy this file to .env.master and fill in your Tailscale IP.
# =============================================================================

# Tailscale IP of this machine (Master)
MASTER_HOST=YOUR_TAILSCALE_IP_HERE

# ---------------------------------------------------------------------------
# Image versions
# ---------------------------------------------------------------------------
HADOOP_IMAGE_TAG=2.0.0-hadoop3.2.1-java8
SPARK_IMAGE_TAG=3.3.0-hadoop3.3
KAFKA_IMAGE_TAG=4.1.1
KAFKA_UI_IMAGE_TAG=latest
AIRFLOW_BASE_IMAGE=apache/airflow:2.10.5-python3.11
POSTGRES_IMAGE_TAG=16
PYSPARK_VERSION=3.3.0
SPARK_KAFKA_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.12:3.3.0

# ---------------------------------------------------------------------------
# Ports (host side)
# ---------------------------------------------------------------------------
NAMENODE_UI_PORT=9870
HDFS_RPC_PORT=9000

# HDFS replication factor — set to 3 once all 3 DataNodes are up
HDFS_REPLICATION=3

SPARK_MASTER_UI_PORT=8080
SPARK_MASTER_PORT=7077

JUPYTER_PORT=8888

KAFKA_INTERNAL_PORT=9092
KAFKA_EXTERNAL_PORT=9094
KAFKA_UI_PORT=8090

AIRFLOW_WEBSERVER_PORT=8082
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

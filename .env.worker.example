# =============================================================================
# Worker Node Environment — EXAMPLE
# Copy this file to .env.worker and fill in your IPs.
# =============================================================================
#
# MASTER_HOST is the Master laptop's Tailscale IPv4 address.
# WORKER_HOST is this Worker laptop's Tailscale IPv4 address.
# =============================================================================

MASTER_HOST=MASTER_TAILSCALE_IP_HERE
WORKER_HOST=YOUR_TAILSCALE_IP_HERE

# ---------------------------------------------------------------------------
# Image versions (must match master)
# ---------------------------------------------------------------------------
HADOOP_IMAGE_TAG=2.0.0-hadoop3.2.1-java8
SPARK_IMAGE_TAG=3.3.0-hadoop3.3

# ---------------------------------------------------------------------------
# HDFS replication — must match master's setting
# ---------------------------------------------------------------------------
HDFS_REPLICATION=3

# ---------------------------------------------------------------------------
# Ports (host side) - Assign UNIQUE ports per worker laptop:
# Worker 1 (ahmed)       → DATANODE_PORT=9866, DATANODE_IPC_PORT=9867, DATANODE_UI_PORT=9864, SPARK_WORKER_PORT=7078, SPARK_WORKER_UI_PORT=8081
# Worker 2 (momen ayman) → DATANODE_PORT=9868, DATANODE_IPC_PORT=9869, DATANODE_UI_PORT=9865, SPARK_WORKER_PORT=7088, SPARK_WORKER_UI_PORT=8082
# Worker 3 (mohamostafa) → DATANODE_PORT=9870, DATANODE_IPC_PORT=9871, DATANODE_UI_PORT=9866, SPARK_WORKER_PORT=7098, SPARK_WORKER_UI_PORT=8083
# ---------------------------------------------------------------------------
DATANODE_UI_PORT=9864
DATANODE_PORT=9866
DATANODE_IPC_PORT=9867
SPARK_WORKER_UI_PORT=8081
SPARK_WORKER_PORT=7078

# ---------------------------------------------------------------------------
# Spark Worker resources — adjust per worker laptop capabilities
# ---------------------------------------------------------------------------
SPARK_WORKER_MEMORY=2G
SPARK_WORKER_CORES=2
